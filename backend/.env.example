# Copy to .env and fill in. Never commit .env.

# MongoDB Atlas (required). Get the connection string from Atlas:
# Connect -> Drivers -> Python. Everyone on the team shares one database.
# Ask the team lead for the password, never put it in git.
MONGODB_URI=
MONGODB_DB=accountable

# true = use the mock Nessie data in backend/app/data/mock_nessie.json
#        (no Nessie key needed; it is loaded into Atlas on first start)
# false = pull from the real Nessie sandbox (needs the two Nessie values below)
USE_MOCK_DATA=true

# Capital One Nessie sandbox (https://api.nessieisreal.com)
NESSIE_API_KEY=
NESSIE_BASE_URL=https://api.nessieisreal.com
# Customer to load when the frontend doesn't specify one
NESSIE_CUSTOMER_ID=

# Gemini (research engine; not wired up yet, see docs/PLAN.md)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Most companies the live server will research on demand per day (see app/services/research_jobs.py).
RESEARCH_DAILY_CAP=10

# US Department of Labor open data key, used only by `python -m scripts.load_data dol`.
# Free: sign in at https://dataportal.dol.gov with login.gov, then API Keys -> create.
DOL_API_KEY=

# Frontend origin(s) allowed by CORS, comma-separated
FRONTEND_ORIGIN=http://localhost:5173

# "production" on the hosted server: drops the localhost origins from CORS and hides /docs.
# Anything other than development/dev/local/test counts as production.
APP_ENV=development

# Secret for POST /api/sync (send it as the X-Admin-Token header). Leave empty to disable
# HTTP sync; `python -m scripts.sync` always works. Generate one with:
#   python -c 'import secrets; print(secrets.token_urlsafe(32))'
ADMIN_TOKEN=

# true lets API callers pick a customer with ?customer_id= and list /api/customers.
# Keep false on any public deploy.
ALLOW_CUSTOMER_OVERRIDE=false

# ImportYeti (real suppliers from US import records). Get a key from importyeti.com; never commit it.
IMPORTYETI_API_KEY=
