# Copy to .env and fill in. Never commit .env.

# MongoDB Atlas (required). Get the connection string from Atlas:
# Connect -> Drivers -> Python. Everyone on the team shares one database.
# Ask the team lead for the password, never put it in git.
MONGODB_URI=
MONGODB_DB=accountable

# true = use the mock Nessie data in backend/app/data/mock_nessie.json
#        (no Nessie key needed; it is loaded into Atlas on first start)
# false = pull from the real Nessie sandbox (needs the two Nessie values below)
USE_MOCK_DATA=true

# Capital One Nessie sandbox (https://api.nessieisreal.com)
NESSIE_API_KEY=
NESSIE_BASE_URL=https://api.nessieisreal.com
# Customer to load when the frontend doesn't specify one
NESSIE_CUSTOMER_ID=

# Gemini (research engine; not wired up yet, see docs/PLAN.md)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Frontend origin(s) allowed by CORS, comma-separated
FRONTEND_ORIGIN=http://localhost:5173
