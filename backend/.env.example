# Copy to .env and fill in. Never commit .env.

# true = use backend/app/data/*.json (works offline, no keys needed)
# false = call the real Nessie sandbox
USE_MOCK_DATA=false

# Capital One Nessie sandbox (http://api.nessieisreal.com)
NESSIE_API_KEY=
NESSIE_BASE_URL=http://api.nessieisreal.com
# Customer to load when the frontend doesn't specify one
NESSIE_CUSTOMER_ID=

# Gemini research engine. Runs only when a key is set AND USE_MOCK_DATA=false.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Frontend origin allowed by CORS
FRONTEND_ORIGIN=http://localhost:5173
